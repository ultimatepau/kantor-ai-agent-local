{
  "name": "kantor-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kantor AI - kantor isometrik 3D berisi tim AI untuk digital agency",
  "scripts": {
    "dev": "npm start",
    "dev:hot": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "serve:api": "node server/index.js",
    "start": "npm run build && concurrently -k -n api,web -c yellow,cyan \"node server/index.js\" \"vite preview\"",
    "pm2:start": "npm run build && pm2 startOrRestart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs kantor-ai-api kantor-ai-web",
    "pm2:status": "pm2 list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "dotenv": "latest",
    "express": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "pm2": "^7.1.0",
    "vite": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
